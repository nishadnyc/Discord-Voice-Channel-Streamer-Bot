# Replace with your actual Discord bot token
DISCORD_TOKEN=bot_token_here

# Replace with your actual Discord client ID for OAUTH login
CLIENT_ID=client_id_here

# Replace with your actual Discord client secret for OAUTH login
DISCORD_CLIENT_SECRET=client_secret_here

# Replace with your actual port
PORT=36363

# Replace with your actual app domain
APP_DOMAIN=http://localhost

# Generate or type a random secret for session keys
SESSION_SECRET=random_secret_here_to_generate_session_keys

# ─── Optional settings ────────────────────────────────────────────────
# Everything below has a sensible default, so it's commented out.
# Uncomment a line only if the note above it describes your situation.


# Uncomment if you want quieter logs. Debug chatter is hidden, but important
# messages (server URL, callback URL, errors) always print.
# DEBUG=false


# Uncomment to change the dashboard title shown on all web pages and in the
# /help embed. Default: "Discord Voice Streamer"
# TITLE=My Custom Title


# Uncomment if the app sits behind a reverse proxy or tunnel (e.g. Cloudflare
# Tunnel) and its public URL differs from APP_DOMAIN:PORT above. Fixes the
# stream links, the OAuth callback URL, and the "Server running at" log line.
# PUBLIC_URL=https://your-domain.com
